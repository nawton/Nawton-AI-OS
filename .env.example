# Database (see docker-compose.yml for local dev)
DATABASE_URL="postgresql://nawton:nawton@localhost:5432/nawton_ai_os?schema=public"

# NextAuth
AUTH_SECRET="generate-with: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI — leave unset to run AI features in demo/mock mode
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# --- Integrations (all optional — MockProvider is used when unset) ---

# Gmail (Google Workspace)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub
GITHUB_TOKEN=""
GITHUB_ORG=""

# Fortnox (Swedish accounting/invoicing)
FORTNOX_CLIENT_ID=""
FORTNOX_CLIENT_SECRET=""
FORTNOX_ACCESS_TOKEN=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
