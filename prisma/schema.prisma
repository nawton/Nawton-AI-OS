// Nawton AI OS — core data model
// Multi-tenant: every business entity is scoped to a Company so the same
// schema can serve many agencies, not just one.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & auth
// ---------------------------------------------------------------------------

model Company {
  id        String   @id @default(cuid())
  name      String
  orgNumber String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  customers   Customer[]
  leads       Lead[]
  projects    Project[]
  invoices    Invoice[]
  emails      Email[]
  documents   Document[]
  workflows   Workflow[]
  aiMemories  AIMemory[]
  conversations Conversation[]
  timeEntries TimeEntry[]
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  email         String    @unique
  passwordHash  String?
  image         String?
  role          UserRole  @default(MEMBER)
  // Internal cost rate used to turn logged hours into an estimated cost —
  // not necessarily what's billed to the client. Nullable with a fallback
  // default in code, so adding a new teammate doesn't require setting this
  // before they can log time.
  hourlyRate    Decimal?  @db.Decimal(10, 2)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  assignedTasks Task[]          @relation("TaskAssignee")
  ownedProjects Project[]       @relation("ProjectOwner")
  conversations Conversation[]
  timeEntries   TimeEntry[]
}

// Standard NextAuth models — kept ready so OAuth providers (Google, GitHub)
// can be enabled later without a schema change.
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

enum CustomerStatus {
  LEAD
  ACTIVE
  PAUSED
  CHURNED
}

model Customer {
  id          String         @id @default(cuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  industry    String?
  status      CustomerStatus @default(ACTIVE)
  value       Decimal        @default(0) @db.Decimal(12, 2)
  notes       String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  contacts    Contact[]
  projects    Project[]
  invoices    Invoice[]
  emails      Email[]
  documents   Document[]
  convertedFromLead Lead?
}

model Contact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  email      String?
  phone      String?
  role       String?
  createdAt  DateTime @default(now())
}

enum LeadPotential {
  LOW
  MEDIUM
  HIGH
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

model Lead {
  id                 String        @id @default(cuid())
  companyId          String
  company            Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String
  companyName        String?
  email              String?
  phone              String?
  source             String?
  industry           String?
  score              Int           @default(0)
  potential          LeadPotential @default(MEDIUM)
  status             LeadStatus    @default(NEW)
  recommendedService String?
  proposedPrice      Decimal?      @db.Decimal(12, 2)
  nextStep           String?
  lastContactedAt     DateTime?
  convertedCustomerId String?       @unique
  convertedCustomer   Customer?     @relation(fields: [convertedCustomerId], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

// ---------------------------------------------------------------------------
// Project management
// ---------------------------------------------------------------------------

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  REVIEW
  DELAYED
  COMPLETED
}

model Project {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name        String
  status      ProjectStatus @default(PLANNING)
  deadline    DateTime?
  budget      Decimal?      @db.Decimal(12, 2)
  ownerId     String?
  owner       User?         @relation("ProjectOwner", fields: [ownerId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks       Task[]
  documents   Document[]
  invoices    Invoice[]
  timeEntries TimeEntry[]
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  timeEntries TimeEntry[]
}

// ---------------------------------------------------------------------------
// Time tracking
// ---------------------------------------------------------------------------

// The foundation profitability reporting stands on: without logged hours,
// "which customers are actually profitable" can only ever compare quoted
// value, never real cost. taskId is optional — logging time against a
// project directly (meetings, general project work) shouldn't require
// inventing a task for it.
model TimeEntry {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  minutes    Int
  note       String?
  loggedAt   DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([companyId, projectId])
}

// ---------------------------------------------------------------------------
// Email assistant
// ---------------------------------------------------------------------------

enum EmailDirection {
  INBOUND
  OUTBOUND
}

model Email {
  id                 String         @id @default(cuid())
  companyId          String
  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId         String?
  customer           Customer?      @relation(fields: [customerId], references: [id])
  direction          EmailDirection @default(INBOUND)
  fromAddress        String
  fromName           String?
  subject            String
  snippet            String
  body               String         @db.Text
  isRead             Boolean        @default(false)
  aiSummary          String?        @db.Text
  aiIndustry         String?
  aiPotential        LeadPotential?
  aiRecommendedService String?
  aiProposedPrice    Decimal?       @db.Decimal(12, 2)
  aiNextStep         String?
  receivedAt         DateTime       @default(now())
}

// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

model Invoice {
  id         String        @id @default(cuid())
  companyId  String
  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  projectId  String?
  project    Project?      @relation(fields: [projectId], references: [id])
  number     String
  amount     Decimal       @db.Decimal(12, 2)
  status     InvoiceStatus @default(DRAFT)
  issuedAt   DateTime      @default(now())
  dueDate    DateTime
  paidAt     DateTime?
}

// ---------------------------------------------------------------------------
// Knowledge base / documents / RAG
// ---------------------------------------------------------------------------

enum DocumentType {
  CONTRACT
  QUOTE
  MEETING_NOTES
  DESIGN
  SPEC
  OTHER
}

model Document {
  id         String       @id @default(cuid())
  companyId  String
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id])
  projectId  String?
  project    Project?     @relation(fields: [projectId], references: [id])
  name       String
  type       DocumentType @default(OTHER)
  content    String       @db.Text
  createdAt  DateTime     @default(now())
}

// Embeddings are stored as plain float arrays for MVP (cosine similarity is
// computed in application code). Swap for pgvector + a native index once
// corpus size warrants it — the AIMemory shape doesn't need to change.
model AIMemory {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceType String
  sourceId   String
  content    String   @db.Text
  embedding  Float[]
  createdAt  DateTime @default(now())

  @@index([companyId, sourceType])
}

// ---------------------------------------------------------------------------
// AI chat
// ---------------------------------------------------------------------------

model Conversation {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @default("Ny konversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages  Message[]
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String       @db.Text
  createdAt      DateTime     @default(now())
}

// ---------------------------------------------------------------------------
// Automation engine
// ---------------------------------------------------------------------------

enum WorkflowStatus {
  ACTIVE
  PAUSED
}

model Workflow {
  id        String         @id @default(cuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  trigger   String
  status    WorkflowStatus @default(ACTIVE)
  steps     Json
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  runs      WorkflowRun[]
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model WorkflowRun {
  id         String            @id @default(cuid())
  workflowId String
  workflow   Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status     WorkflowRunStatus @default(PENDING)
  log        String?           @db.Text
  startedAt  DateTime          @default(now())
  finishedAt DateTime?
}
